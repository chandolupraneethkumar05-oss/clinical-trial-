# ProtocolShield Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your .env file or real secrets to Git.

ENVIRONMENT=development
DEBUG=false

# ── JWT Authentication (REQUIRED) ───────────────────────────────────────────
# In production, application startup will strictly FAIL if this secret is missing
# or set to the development default.
# Generate a cryptographically strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Frontend & CORS Configuration ──────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Google OAuth 2.0 / OIDC (OPTIONAL) ──────────────────────────────────────
# Standard email/password authentication works fully without Google credentials.
# Target: ₹0 cost implementation using standard OIDC ID-token verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Production Email Delivery (OPTIONAL) ────────────────────────────────────
# In development, single-use password reset tokens are returned in the response
# for local testing. In production (ENVIRONMENT=production), tokens are NEVER returned
# in the API response and require email delivery configuration (e.g. SendGrid/Resend).
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=noreply@protocolshield.org
