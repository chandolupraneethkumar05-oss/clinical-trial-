# ProtocolShield Environment Configuration
# Copy this file to .env for local development.
# NEVER commit .env files or real production secrets to Git.

# ── Runtime Mode (Required in Production) ────────────────────────────────────
ENVIRONMENT=development          # development | test | production
DEBUG=false                      # MUST be false in production

# ── Database & Seeding (Required in Production) ──────────────────────────────
# Local DuckDB file requires single-process access (--workers 1 / WEB_CONCURRENCY=1).
# In production, mount persistent volume and set DB_PATH=/var/data/protocolshield_cohort.duckdb.
DB_PATH=backend/data/protocolshield_cohort.duckdb
ENABLE_DEMO_SEEDING=true         # MUST be false in production
EXPOSE_DEV_RESET_TOKEN=false     # Development testing ONLY; MUST be false in production

# ── JWT Authentication (REQUIRED) ────────────────────────────────────────────
# Production startup fails closed if missing, short, low-entropy, or dev default.
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=protocolshield-api
JWT_AUDIENCE=protocolshield-client
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=15

# ── Frontend Origin, CORS & Reverse Proxy Trust (Required in Production) ─────
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
# Explicit reverse-proxy IPs allowed to supply X-Forwarded-For (comma-separated or JSON list; never '*' in prod)
TRUSTED_PROXIES=127.0.0.1,::1

# Frontend build-time API origin (set in frontend hosting environment if UI & API differ):
# VITE_API_BASE_URL=https://protocolshield-api.onrender.com

# ── Password Reset Email Delivery (REQUIRED for Forgot-Password in Prod) ──────
# Supported EMAIL_PROVIDER values: resend | sendgrid | mailgun | smtp
# When unconfigured in production, /api/v1/auth/forgot-password/request returns HTTP 503.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_MAILGUN_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ── External Integrations (Optional) ─────────────────────────────────────────
# Standard email/password login works without Google OAuth; leave blank to disable Google Sign-In.
GOOGLE_CLIENT_ID=
CLINICAL_TRIALS_API_BASE=https://clinicaltrials.gov/api/v2

# ── AI Assistant / Voice Intelligence (Optional) ─────────────────────────────
# Keep server-side only. When blank, the AI Assistant uses the verified local glossary & live DB stats.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.8-flash
