# ProtocolShield Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your .env file or real secrets to Git.

ENVIRONMENT=development
DEBUG=false

# ── Database & Security Guardrails ──────────────────────────────────────────
# Single-worker persistent DuckDB path (in production, fails closed if locked)
# DB_PATH=backend/data/protocolshield_cohort.duckdb
ENABLE_DEMO_SEEDING=true
EXPOSE_DEV_RESET_TOKEN=true

# ── JWT Authentication (REQUIRED) ───────────────────────────────────────────
# In production, application startup strictly FAILS if this secret is missing,
# short, low-entropy, or matches development defaults.
# Generate a cryptographically strong secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Frontend, CORS & Trusted Proxies ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
# Comma-separated or JSON list of reverse-proxy IPs allowed to supply X-Forwarded-For
TRUSTED_PROXIES=127.0.0.1,::1

# Frontend static host env var (set in frontend/.env or hosting platform when UI & API differ):
# VITE_API_BASE_URL=https://api.example.com

# ── Google OAuth 2.0 / OIDC (OPTIONAL) ──────────────────────────────────────
# Standard email/password authentication works fully without Google credentials.
# Target: ₹0 cost implementation using standard OIDC ID-token verification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Production Email Delivery (REQUIRED for forgot-password in prod) ─────────
# Supported EMAIL_PROVIDER values: resend | sendgrid | mailgun | smtp
# In production (ENVIRONMENT=production), tokens are NEVER returned in API responses;
# forgot-password returns HTTP 503 if email delivery is unconfigured.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=noreply@protocolshield.org
EMAIL_MAILGUN_DOMAIN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
