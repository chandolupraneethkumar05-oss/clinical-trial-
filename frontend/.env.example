# ProtocolShield Frontend Build Environment Variables
# Never place private backend secrets or API keys in VITE_* variables
# because Vite embeds VITE_* values into public client JavaScript bundles.

# Optional: Backend API origin when frontend static hosting is on a separate domain
# (leave unset in local dev to use Vite's /api proxy to http://127.0.0.1:8000).
# VITE_API_BASE_URL=https://protocolshield-api.onrender.com
