# ProtocolShield Frontend Environment Variables
# Optional: set only when frontend is hosted on a separate origin from FastAPI
# (when running locally with Vite proxy, leave empty).
# VITE_API_BASE_URL=https://your-backend-service.onrender.com

# Optional: Google OAuth 2.0 Client ID for frontend Google Sign-In button
# VITE_GOOGLE_CLIENT_ID=
